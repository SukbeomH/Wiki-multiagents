# ==============================================================================
# AI 한국은행 경제 분석팀 - 환경 변수 설정
# ==============================================================================
# 이 파일을 .env로 복사하고 실제 값으로 수정하세요.
# cp env.example .env

# ==============================================================================
# Azure OpenAI 설정 (필수)
# ==============================================================================
# Azure OpenAI 서비스 엔드포인트
AOAI_ENDPOINT=https://your-resource.openai.azure.com/

# Azure OpenAI API 키
AOAI_API_KEY=your-azure-openai-api-key

# Azure OpenAI 모델 배포명
AOAI_DEPLOY_GPT4O=gpt-4o
AOAI_DEPLOY_GPT4O_MINI=gpt-4o-mini
AOAI_DEPLOY_EMBED_3_LARGE=text-embedding-3-large
AOAI_DEPLOY_EMBED_3_SMALL=text-embedding-3-small
AOAI_DEPLOY_EMBED_ADA=text-embedding-ada-002

# Azure API 버전 (변경하지 마세요)
AZURE_API_VERSION=2024-02-01

# ==============================================================================
# 애플리케이션 설정
# ==============================================================================
# 로그 레벨 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 데이터 디렉토리
DATA_DIR=data

# 앱 그래프 버전
APP_GRAPH_VERSION=3

# 최대 반복 횟수
MAX_ITERATIONS=10

# 타임아웃 (초)
TIMEOUT_SECONDS=300

# ==============================================================================
# RAG (Retrieval-Augmented Generation) 설정
# ==============================================================================
# 검색 전략 (mmr, similarity)
RAG_SEARCH_STRATEGY=mmr

# 검색 결과 수
RAG_K=5

# 가져올 결과 수
RAG_FETCH_K=20

# MMR 람다 값 (0.0 ~ 1.0)
RAG_LAMBDA_MULT=0.7

# 점수 임계값 (0.0 ~ 1.0)
RAG_SCORE_THRESHOLD=0.7

# 압축 사용 여부 (true/false)
RAG_USE_COMPRESSION=false

# ==============================================================================
# KOSIS (통계청) 설정 (선택사항)
# ==============================================================================
# KOSIS 오픈 API 키 (https://kosis.kr/openapi/ 에서 무료 발급)
KOSIS_API_KEY=

# ==============================================================================
# 웹 검색 설정 (선택사항)
# ==============================================================================
# 웹 검색 기능은 기본 검색 엔진을 사용합니다.

# ==============================================================================
# 개발/디버깅 설정
# ==============================================================================
# 디버그 모드 (true/false)
DEBUG_MODE=false

# 캐시 사용 여부 (true/false)
USE_CACHE=true

# 캐시 만료 시간 (초)
CACHE_EXPIRY=3600 